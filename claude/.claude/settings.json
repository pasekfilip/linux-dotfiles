{
  "permissions": {
    "defaultMode": "auto"
  },
  "model": "opus[1m]",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "setsid -f tmux-agent-flag working >/dev/null 2>&1 </dev/null"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "setsid -f tmux-agent-flag blocked >/dev/null 2>&1 </dev/null"
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "setsid -f tmux-agent-flag blocked >/dev/null 2>&1 </dev/null"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "setsid -f tmux-agent-flag done >/dev/null 2>&1 </dev/null"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "setsid -f tmux-agent-flag clear >/dev/null 2>&1 </dev/null"
          }
        ]
      }
    ]
  },
  "effortLevel": "high",
  "modelSettings": {
    "claude-opus-5": {
      "effortLevel": "medium"
    },
    "claude-sonnet-5": {
      "effortLevel": "medium"
    }
  },
  "promptSuggestionEnabled": false,
  "skipDangerousModePermissionPrompt": true,
  "theme": "auto",
  "agentPushNotifEnabled": true,
  "promptSuggestionEnabled": false
}
